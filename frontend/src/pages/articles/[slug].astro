---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StrapiBlocks from '../../components/common/StrapiBlocks.astro';
import fetchApi from '../../lib/strapi';
import type { Article, StrapiCollectionResponse } from '../../interfaces/strapi';
import { getLocale, translations } from '../../lib/i18n';

export async function getStaticPaths() {
  const response = await fetchApi<StrapiCollectionResponse<Article>>({
      endpoint: 'articles',
      query: {
        'populate[coverImage]': 'true',
        'populate[author][populate][0]': 'profileImage',
        'populate[tags]': 'true',
        'pagination[pageSize]': '100',
      },
    });

  return response.data.map((article) => ({
    params: {
      slug: article.slug,
    },
    props: {
      article,
    },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = translations[locale];
const tags = Array.isArray(article.tags) ? article.tags : [];

const strapiUrl = import.meta.env.STRAPI_URL;
const getMediaUrl = (url: string) =>
  url.startsWith('http') ? url : `${strapiUrl}${url}`;

const coverUrl = article.coverImage
  ? getMediaUrl(article.coverImage.formats?.large?.url ?? article.coverImage.url)
  : null;

const authorImageUrl = article.author?.profileImage
  ? getMediaUrl(
      article.author.profileImage.formats?.thumbnail?.url ??
        article.author.profileImage.url,
    )
  : null;

const publicationDate = new Intl.DateTimeFormat(
  locale === 'pt' ? 'pt-PT' : 'en',
  {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }
).format(new Date(article.publishedAt));
---

<BaseLayout title={`${article.title} | Travel Blog`} description={article.summary}>
    <header class="galleryHeader">
    <section
      class="articleHero"
      style={`background-image:
        linear-gradient(to right, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.7) 5%, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.7) 95%, rgba(0, 0, 0, 0.95) 100%),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.3) 20%, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.3) 80%, rgba(0, 0, 0, 0.95) 100%),
        url('${coverUrl ?? ''}');`}
    >
    </section>

    <div class="heroOverlayContent">
      <h1>{article.title}</h1>
      <p>{article.summary}</p>
    </div>
  </header>
  <article class="articleContent">
    <div class="articleMeta">
      <span class="authorInfo">
        <span>{t.articlePage.writtenBy} {article.author?.name ?? 'TravelBlog'}</span>
        {authorImageUrl && (
          <img
            class="authorImage"
            src={authorImageUrl}
            alt={article.author?.profileImage?.alternativeText ?? article.author?.name ?? t.articlePage.author}
          />
        )}
      </span>
      <span class="metaDivider" aria-hidden="true">|</span>
      <time datetime={article.publishedAt}>{publicationDate}</time>
      {
        tags.length > 0 && (
          <>
            <span class="metaDivider" aria-hidden="true">|</span>
            <div class="articleTags" aria-label={t.articlePage.tags}>
              {tags.map((tag) => <span class="articleTag">{tag.name}</span>)}
            </div>
          </>
        )
      }
    </div>

    <div class="articleBlocks">
      <StrapiBlocks content={article.content ?? []} mediaBaseUrl={strapiUrl} />
    </div>
  </article>
</BaseLayout>

<style>
  .galleryHeader {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden; /* Corta rigorosamente o blur que tenta sair para fora */
    background-color: #000000; /* Garante que qualquer espaço vazio atrás é preto */
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .articleHero {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(4.5px) brightness(0.7); /* Aplica o efeito de desfoque e escurece a imagem */
    /*transform: scale(.55);  Empurra as bordas brancas do blur para fora do ecrã */
    z-index: 1;
  }

  .heroOverlayContent {
    position: relative;
    z-index: 2; /* Mantém o texto nítido por cima do fundo desfocado */
    box-sizing: border-box;
    width: min(1060px, calc(100% - 48px));
    text-align: center;
    color: #ffffff;
    border: 3px solid #ffffff;
    padding: 74px 8px 96px;
  }

  .heroOverlayContent h1 {
    max-width: 880px;
    margin: 0 auto;
    font-size: 110px;
    line-height: 1;

  }
  .heroOverlayContent p {
    font-size: 20px;
    max-width: 800px;
    margin: 32px auto 0;
  }

  .articleContent {
    width: min(100% - 64px, 1000px);
    margin: 0 auto;
    padding: 72px 0 96px;
  }

  .articleMeta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 4rem;
    color: #64748b;
    font-size: 0.9rem;
    text-align: center;
  }

  .metaDivider {
    color: #cbd5e1;
  }

  .authorInfo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .authorImage {
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    object-fit: cover;
  }

  .articleTags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
  }

  .articleTag {
    color: #ffffff;
    font-weight: 500;
    background-color: var(--color-primary);
    border-radius: 3px;
    padding: 0.2rem 0.4rem;
  }

  .articleBlocks {
    width: 100%;
  }


</style>