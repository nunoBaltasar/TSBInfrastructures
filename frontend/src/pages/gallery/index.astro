---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fetchApi from '../../lib/strapi';
import headerImage from '../../assets/friskymountains.png';
import GalleryCard from '../../components/common/GalleryCard.astro';
import type {
  GalleryImage,
  StrapiCollectionResponse,
  Tag,
} from '../../interfaces/strapi';
import { getLocale, translations } from '../../lib/i18n';
import { getMediaUrl } from '../../lib/media';

const locale = getLocale(Astro.url.pathname);
const t = translations[locale];
const galleryPageSize = 10;
const galleryImagesResponse = await fetchApi<
  StrapiCollectionResponse<GalleryImage>
>({
  endpoint: 'gallery-images',
  locale,
  query: {
    'populate[image]': 'true',
    'populate[author][populate][0]': 'profileImage',
    'populate[tags]': 'true',
    sort: 'publishedAt:desc',
    'pagination[page]': '1',
    'pagination[pageSize]': '100',
  },
});
const tagsResponse = await fetchApi<StrapiCollectionResponse<Tag>>({
  endpoint: 'tags',
  locale,
  query: {
    sort: 'name:asc',
    'pagination[pageSize]': '100',
  },
});
const availableTags = tagsResponse.data.filter(
  (tag, index, tags) =>
    tags.findIndex((candidate) =>
      (candidate.documentId ?? candidate.id) === (tag.documentId ?? tag.id),
    ) === index,
);
---

<BaseLayout title={`${t.galleryPage.title} | TravelBlog`}>
    
    <header class="galleryHeader">
        <section style =  {`background-image:
        linear-gradient(to bottom,rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.4) 50%, rgba(0, 0, 0, 0.75) 100%),
        url('${headerImage.src}'); background-size: 100% 100%; background-position: center; 
        background-repeat: no-repeat; background-attachment: fixed;  height: 100vh; width: 100%;`
        }>
        
            <h1>{t.galleryPage.title}</h1>
            <p>{t.galleryPage.description}</p>
        </section> 
    </header>
    <main class="galleryPage">

    <div class="galleryFilter">
      <span>{t.galleryPage.filterBy}</span>
      <div class="galleryFilterMenu">
        <button
          type="button"
          class="galleryFilterButton"
          data-gallery-filter-button
          aria-expanded="false"
        >
          {t.galleryPage.allTags}
        </button>
        <div class="galleryFilterOptions" data-gallery-filter-options hidden>
          <button type="button" data-gallery-tag="" data-gallery-tag-name={t.galleryPage.allTags}>
            {t.galleryPage.allTags}
          </button>
          {availableTags.map((tag) => (
            <button
              type="button"
              data-gallery-tag={tag.documentId}
              data-gallery-tag-name={tag.name}
            >
              {tag.name}
            </button>
          ))}
        </div>
      </div>
    </div>

    <section
      class="galleryGrid"
      aria-label={t.galleryPage.ariaLabel}
      data-gallery-grid
      data-locale={locale}
      data-page-size={galleryPageSize}
      data-page-count={galleryImagesResponse.meta.pagination.pageCount}
      data-load-more-text={t.galleryPage.loadMore}
      data-loading-text={t.galleryPage.loading}
      data-load-error-text={t.galleryPage.loadError}
      data-published-on-text={t.galleryPage.publishedOn}
      data-by-text={t.galleryPage.by}
      data-enlarge-text={t.galleryPage.enlarge}
      data-reduce-text={t.galleryPage.reduce}
    >
      {galleryImagesResponse.data.map((galleryImage, index) =>
        galleryImage.image ? (
          <GalleryCard
            title={galleryImage.title}
            description={galleryImage.description}
            location={galleryImage.location}
            publishedAt={galleryImage.publishedAt}
            authorName={galleryImage.author?.name}
            tags={galleryImage.tags?.map((tag) => tag.name)}
            tagIds={galleryImage.tags?.map((tag) => tag.documentId)}
            authorImage={galleryImage.author?.profileImage
              ? getMediaUrl(
                  galleryImage.author.profileImage.formats?.thumbnail?.url ??
                    galleryImage.author.profileImage.url
                )
              : undefined}
            slug={galleryImage.slug}
            image={getMediaUrl(
              galleryImage.image.formats?.large?.url ??
                galleryImage.image.formats?.medium?.url ??
                galleryImage.image.url
            )}
            hidden={index >= galleryPageSize}
          />
        ) : null
      )}
    </section>

    <dialog class="galleryDialog" data-gallery-dialog>
      <div class="galleryDialogContent">
        <header class="galleryDialogHeader">
          <div class="DialogAuthor">
              <img class = "pfp"data-gallery-dialog-author-image alt="" />
              <div class="galleryDialogAuthor">
                <h2 data-gallery-dialog-title></h2>
                <p data-gallery-dialog-author></p>
              </div>
          </div>
          <button type="button" class="galleryDialogClose" data-gallery-dialog-close aria-label={t.galleryPage.close}>
            ×
          </button>
        </header>
        <div class="galleryDialogImageContainer">
          <img data-gallery-dialog-image alt="" />
        </div>
          <div class = "dialogMeta">
            <div class = "location">
              <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
              fill="currentColor" viewBox="0 0 24 24" >
              <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
              <path d="M11.42 21.81c.17.12.38.19.58.19s.41-.06.58-.19c.3-.22 7.45-5.37 7.42-11.82 0-4.41-3.59-8-8-8s-8 3.59-8 8c-.03 6.45 7.12 11.6 7.42 11.82M12 4c3.31 0 6 2.69 6 6 .02 4.44-4.39 8.43-6 9.74-1.61-1.31-6.02-5.29-6-9.74 0-3.31 2.69-6 6-6"></path>
              </svg>
              <span data-gallery-dialog-location></span>
            </div>
            <div class  = "date">
              <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
              fill="currentColor" viewBox="0 0 24 24" >
              <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
              <path d="M19 4h-2V2h-2v2H9V2H7v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2M5 20V8h14V6v14z"></path>
              </svg>
              <p data-gallery-dialog-published></p>
            </div>
            <div class="galleryDialogTags" data-gallery-dialog-tags></div>
            <p data-gallery-dialog-description></p>
            
          </div>
      </div>
    </dialog>

    {galleryImagesResponse.data.length > galleryPageSize && (
      <div class="galleryLoadMore">
        <button type="button" class="galleryLoadMoreButton" data-gallery-load-more>
          {t.galleryPage.loadMore}
        </button>
      </div>
    )}
  </main>
</BaseLayout>

<script>

  const initializeGallery = () => {
    const grid = document.querySelector<HTMLElement>('[data-gallery-grid]');
    const loadMoreButton =
      document.querySelector<HTMLButtonElement>('[data-gallery-load-more]');
    const filterButton =
      document.querySelector<HTMLButtonElement>('[data-gallery-filter-button]');
    const filterOptions =
      document.querySelector<HTMLElement>('[data-gallery-filter-options]');

    if (!grid || !loadMoreButton || !filterButton || !filterOptions) {
      return;
    }

    const loadMoreText = grid.dataset.loadMoreText ?? 'Load more';
    const pageSize = Number(grid.dataset.pageSize);

    if (!Number.isInteger(pageSize)) {
      return;
    }

    let selectedTagDocumentId = '';
    let visibleCards: HTMLButtonElement[] = [];

    filterButton.addEventListener('click', () => {
      const isOpen = filterButton.getAttribute('aria-expanded') === 'true';
      filterButton.setAttribute('aria-expanded', String(!isOpen));
      filterOptions.hidden = isOpen;
    });

    const applyFilter = () => {
      const allCards =
        Array.from(
          grid.querySelectorAll<HTMLButtonElement>('[data-gallery-image]'),
        );

      visibleCards = allCards.filter((card) => {
        if (!selectedTagDocumentId) {
          return true;
        }

        const tagIds =
          card.dataset.galleryTagIds?.split('|').filter(Boolean) ?? [];
        return tagIds.includes(selectedTagDocumentId);
      });

      allCards.forEach((card) => {
        card.hidden = true;
      });

      visibleCards.slice(0, pageSize).forEach((card) => {
        card.hidden = false;
      });

      loadMoreButton.hidden = visibleCards.length <= pageSize;
      loadMoreButton.textContent = loadMoreText;
    };

    filterOptions.querySelectorAll<HTMLButtonElement>('[data-gallery-tag]').forEach(
      (tagOption) => {
        tagOption.addEventListener('click', () => {
          selectedTagDocumentId = tagOption.dataset.galleryTag ?? '';
          filterButton.textContent =
            tagOption.dataset.galleryTagName ?? loadMoreText;
          filterButton.setAttribute('aria-expanded', 'false');
          filterOptions.hidden = true;
          applyFilter();
        });
      },
    );

    loadMoreButton.addEventListener('click', () => {
      if (visibleCards.length === 0) {
        visibleCards =
          Array.from(
            grid.querySelectorAll<HTMLButtonElement>('[data-gallery-image]'),
          ).filter((card) => {
            if (!selectedTagDocumentId) {
              return true;
            }
            const tagIds =
              card.dataset.galleryTagIds?.split('|').filter(Boolean) ?? [];
            return tagIds.includes(selectedTagDocumentId);
          });
      }

      const visibleCount =
        visibleCards.filter((card) => !card.hidden).length;
      visibleCards
        .slice(visibleCount, visibleCount + pageSize)
        .forEach((card) => {
          card.hidden = false;
        });

      const updatedVisibleCount =
        visibleCards.filter((card) => !card.hidden).length;

      if (updatedVisibleCount >= visibleCards.length) {
        loadMoreButton.hidden = true;
        return;
      }
    });

    applyFilter();
  };

  const initializeGalleryDialog = () => {
    const grid = document.querySelector<HTMLElement>('[data-gallery-grid]');
    const dialog = document.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
    const image = document.querySelector<HTMLImageElement>('[data-gallery-dialog-image]');
    const title = document.querySelector<HTMLElement>('[data-gallery-dialog-title]');
    const author = document.querySelector<HTMLElement>('[data-gallery-dialog-author]');
    const authorImage = document.querySelector<HTMLImageElement>(
      '[data-gallery-dialog-author-image]',
    );
    const location = document.querySelector<HTMLElement>('[data-gallery-dialog-location]');
    const published = document.querySelector<HTMLElement>('[data-gallery-dialog-published]');
    const description = document.querySelector<HTMLElement>('[data-gallery-dialog-description]');
    const tags = document.querySelector<HTMLElement>('[data-gallery-dialog-tags]');
    const closeButton = document.querySelector<HTMLButtonElement>('[data-gallery-dialog-close]');
    const locale = grid?.dataset.locale ?? 'pt';
    const byText = grid?.dataset.byText ?? 'By';
    const publishedOnText = grid?.dataset.publishedOnText ?? 'Published on';
    const enlargeText = grid?.dataset.enlargeText ?? 'Enlarge image';
    const reduceText = grid?.dataset.reduceText ?? 'Reduce image';

    if (
      !dialog ||
      !image ||
      !title ||
      !author ||
      !authorImage ||
      !location ||
      !published ||
      !description ||
      !tags ||
      !closeButton
    ) {
      return;
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      const card =
        target instanceof Element
          ? target.closest<HTMLElement>('[data-gallery-image]')
          : null;

      if (!card) {
        return;
      }

      event.preventDefault();
      image.classList.remove('isZoomed');
      image.setAttribute('aria-label', enlargeText);
      image.src = card.dataset.galleryImage ?? '';
      image.alt = card.dataset.galleryTitle ?? '';
      title.textContent = card.dataset.galleryTitle ?? '';
      author.textContent = card.dataset.galleryAuthor
        ? `${byText} ${card.dataset.galleryAuthor}`
        : '';
      authorImage.src = card.dataset.galleryAuthorImage ?? '';
      authorImage.alt = card.dataset.galleryAuthor ?? '';
      authorImage.hidden = !card.dataset.galleryAuthorImage;
      location.textContent = card.dataset.galleryLocation ?? '';
      published.textContent = card.dataset.galleryPublished
        ? `${publishedOnText} ${new Intl.DateTimeFormat(locale === 'pt' ? 'pt-PT' : 'en', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          }).format(new Date(card.dataset.galleryPublished))}`
        : '';
      description.textContent = card.dataset.galleryDescription ?? '';
      tags.replaceChildren(
        ...(card.dataset.galleryTags ?? '')
          .split('|')
          .filter(Boolean)
          .map((tag) => {
            const tagElement = document.createElement('span');
            tagElement.textContent = `${tag}`;
            return tagElement;
          }),
      );
      dialog.showModal();
    });

    image.addEventListener('click', () => {
      const isZoomed = image.classList.toggle('isZoomed');
      image.setAttribute(
        'aria-label',
        isZoomed ? reduceText : enlargeText,
      );
    });

    closeButton.addEventListener('click', () => {
      image.classList.remove('isZoomed');
      dialog.close();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeGallery, {
      once: true,
    });
  } else {
    initializeGallery();
  }

  initializeGalleryDialog();
</script>

<style>
  .galleryPage {
    padding: 80px;
    background: #ffffff;
  }

  .galleryHeader {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    
    }
.galleryHeader section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 100%;
  }
  .galleryHeader h1 {
    margin: 0;
    font-size: 200px;
    color: #ffffff;
  }

  .galleryHeader p {
    font-size: 20px;
    color: #ffffff;
  }

  .galleryGrid {
    display: block;
    column-count: 3;
    column-gap: 24px;
    max-width: 1440px;
    margin: 0 auto;
  }

  .galleryFilter {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 1440px;
    margin: 0 auto 24px;
    padding-bottom: 15px;
    border-bottom: 3px solid #000000;
    color: #000;
    font-size: 26px;
  }

  .galleryFilterMenu {
    position: relative;
  }

  .galleryFilterButton,
  .galleryFilterOptions button {
    border: 2px solid #000;
    border-radius: 4px;
    cursor: pointer;
    font: inherit;
  }

  .galleryFilterButton {
    min-width: 120px;
    padding: 0.35rem 1rem;
  }

  .galleryFilterOptions {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 20;
    min-width: 180px;
    max-height: 260px;
    overflow-y: auto;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    background: #ffffff;
  }

  .galleryFilterOptions button {
    display: block;
    width: 100%;
    border: 0;
    border-radius: 0;
    padding: 0.65rem 1rem;
    text-align: left;
  }

  .galleryFilterOptions button:hover,
  .galleryFilterOptions button:focus-visible {
    background: #f1f5f9;
  }

  .galleryLoadMore {
    display: flex;
    justify-content: center;
    margin: 24px auto 0;
    font-size: 20px;
    font-weight: bold;
  }
  

  .galleryLoadMoreButton {
    border: 0;
    border-radius: 4px;
    background: var(--color-primary);
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    padding: 0.75rem 11rem;
  }
  .galleryLoadMoreButton:hover{
    transition: background-color 0.3s ease;
    background-color: var(--color-primary-dark);
  }

  .galleryLoadMoreButton:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  @media (max-width: 1100px) {
    .galleryPage {
      padding: 60px 32px;
    }

    .galleryHeader h1 {
      font-size: clamp(72px, 14vw, 140px);
    }

    .galleryGrid {
      column-count: 2;
    }
  }

  @media (max-width: 760px) {
    .galleryPage {
      padding: 40px 20px;
    }

    .galleryHeader h1 {
      font-size: clamp(48px, 16vw, 72px);
    }

    .galleryHeader p {
      padding: 0 20px;
    }

    .galleryFilter {
      align-items: flex-start;
      font-size: 20px;
      margin-bottom: 16px;
    }

    .galleryGrid {
      column-count: 1;
    }

    .galleryLoadMoreButton {
      width: 100%;
      padding-inline: 20px;
    }

    .galleryDialog {
      width: calc(100% - 16px);
    }
  }

  .galleryDialog {
    width: min(96%, 1152px);
    max-height: 94vh;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: #ffffff;
    scrollbar-width: none; /* Deixa a barra de rolagem fina */
  }

  .galleryDialog::backdrop {
    background: rgb(0 0 0 / 70%);
  }

  .galleryDialogContent {
    display: flex;
    max-height: 94vh;
    flex-direction: column;
  }

  .galleryDialogHeader{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  .galleryDialogHeader {
    border-bottom: 1px solid #e2e8f0;
  }

  .galleryDialogHeader h2,
  .galleryDialogHeader p,
  .galleryDialogFooter p {
    margin: 0;
  }
  .galleryDialogHeader{
    
  }
  .DialogAuthor{
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .galleryDialogAuthor {
    align-items: center;
    margin-left: 1rem;
  }
  .galleryDialogAuthor p{
    margin-top: -5px;
  }

  .pfp {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    object-fit: cover;
  }

  .galleryDialogHeader h2 {
    color: #0f172a;
    font-size: 1.55rem;
  }

  .galleryDialogHeader p {
    color: #64748b;
    font-size: 0.9rem;
  }

  .galleryDialogClose {
    border: 0;
    border-radius: 9999px;
    background: transparent;
    cursor: pointer;
    font-size: 2rem;
    line-height: 1;
    padding: 0.25rem 0.75rem;
  }

  .galleryDialogImageContainer {
    padding: 1.5rem;
  }

  .galleryDialogImageContainer img {
    display: block;
    max-width: 100%;
    max-height: calc(94vh - 220px);
    width: auto;
    margin: 0 auto;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform 0.3s ease;
  }

  .galleryDialogImageContainer img.isZoomed {
    max-width: none;
    max-height: none;
    transform: scale(1.8);
    cursor: zoom-out;
  }

  .dialogMeta{
    padding: 0 1.5rem 1.5rem;
  }

  .dialogMeta p {
    margin: 0.5rem 0 0;
  }

  .galleryDialogTags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  :global(.galleryDialogTags span) {
    border-radius: 3px;
    background-color: var(--color-primary);
    padding: 0.2rem 0.4rem;
    color: #ffffff;
    font-size: 0.875rem;
  }

  .location, .date{
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.35rem;
  }
</style>

