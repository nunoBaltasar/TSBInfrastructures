---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fetchApi from '../../lib/strapi';
import headerImage from '../../assets/friskymountains.png';
import GalleryCard from '../../components/common/GalleryCard.astro';
import type {
  GalleryImage,
  StrapiCollectionResponse,
  Tag,
} from '../../interfaces/strapi';
import { getLocale, translations } from '../../lib/i18n';
import { getMediaUrl } from '../../lib/media';

const locale = getLocale(Astro.url.pathname);
const t = translations[locale];
const galleryPageSize = 10;
const galleryImagesResponse = await fetchApi<
  StrapiCollectionResponse<GalleryImage>
>({
  endpoint: 'gallery-images',
  locale,
  query: {
    'populate[image]': 'true',
    'populate[author][populate][0]': 'profileImage',
    'populate[tags]': 'true',
    sort: 'publishedAt:desc',
    'pagination[page]': '1',
    'pagination[pageSize]': String(galleryPageSize),
  },
});
const tagsResponse = await fetchApi<StrapiCollectionResponse<Tag>>({
  endpoint: 'tags',
  locale,
  query: {
    sort: 'name:asc',
    'pagination[pageSize]': '100',
  },
});
const availableTags = tagsResponse.data.filter(
  (tag, index, tags) =>
    tags.findIndex((candidate) =>
      (candidate.documentId ?? candidate.id) === (tag.documentId ?? tag.id),
    ) === index,
);

const strapiUrl = import.meta.env.STRAPI_URL;
---

<BaseLayout title={`${t.galleryPage.title} | TravelBlog`}>
    
    <header class="galleryHeader">
        <section style =  {`background-image:
        linear-gradient(to bottom,rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.4) 50%, rgba(0, 0, 0, 0.75) 100%),
        url('${headerImage.src}'); background-size: 100% 100%; background-position: center; 
        background-repeat: no-repeat; background-attachment: fixed;  height: 100vh; width: 100%;`
        }>
        
            <h1>{t.galleryPage.title}</h1>
            <p>{t.galleryPage.description}</p>
        </section> 
    </header>
    <main class="galleryPage">

    <div class="galleryFilter">
      <span>{t.galleryPage.filterBy}</span>
      <div class="galleryFilterMenu">
        <button
          type="button"
          class="galleryFilterButton"
          data-gallery-filter-button
          aria-expanded="false"
        >
          {t.galleryPage.allTags}
        </button>
        <div class="galleryFilterOptions" data-gallery-filter-options hidden>
          <button type="button" data-gallery-tag="" data-gallery-tag-name={t.galleryPage.allTags}>
            {t.galleryPage.allTags}
          </button>
          {availableTags.map((tag) => (
            <button
              type="button"
              data-gallery-tag={tag.documentId}
              data-gallery-tag-name={tag.name}
            >
              {tag.name}
            </button>
          ))}
        </div>
      </div>
    </div>

    <section
      class="galleryGrid"
      aria-label={t.galleryPage.ariaLabel}
      data-gallery-grid
      data-strapi-url={strapiUrl}
      data-locale={locale}
      data-page-size={galleryPageSize}
      data-page-count={galleryImagesResponse.meta.pagination.pageCount}
      data-load-more-text={t.galleryPage.loadMore}
      data-loading-text={t.galleryPage.loading}
      data-load-error-text={t.galleryPage.loadError}
      data-published-on-text={t.galleryPage.publishedOn}
      data-by-text={t.galleryPage.by}
      data-enlarge-text={t.galleryPage.enlarge}
      data-reduce-text={t.galleryPage.reduce}
    >
      {galleryImagesResponse.data.map((galleryImage) =>
        galleryImage.image ? (
          <GalleryCard
            title={galleryImage.title}
            description={galleryImage.description}
            location={galleryImage.location}
            publishedAt={galleryImage.publishedAt}
            authorName={galleryImage.author?.name}
            tags={galleryImage.tags?.map((tag) => tag.name)}
            authorImage={galleryImage.author?.profileImage
              ? getMediaUrl(
                  galleryImage.author.profileImage.formats?.thumbnail?.url ??
                    galleryImage.author.profileImage.url
                )
              : undefined}
            slug={galleryImage.slug}
            image={getMediaUrl(
              galleryImage.image.formats?.large?.url ??
                galleryImage.image.formats?.medium?.url ??
                galleryImage.image.url
            )}
          />
        ) : null
      )}
    </section>

    <dialog class="galleryDialog" data-gallery-dialog>
      <div class="galleryDialogContent">
        <header class="galleryDialogHeader">
          <div class="DialogAuthor">
              <img class = "pfp"data-gallery-dialog-author-image alt="" />
              <div class="galleryDialogAuthor">
                <h2 data-gallery-dialog-title></h2>
                <p data-gallery-dialog-author></p>
              </div>
          </div>
          <button type="button" class="galleryDialogClose" data-gallery-dialog-close aria-label={t.galleryPage.close}>
            ×
          </button>
        </header>
        <div class="galleryDialogImageContainer">
          <img data-gallery-dialog-image alt="" />
        </div>
          <div class = "dialogMeta">
            <div class = "location">
              <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
              fill="currentColor" viewBox="0 0 24 24" >
              <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
              <path d="M11.42 21.81c.17.12.38.19.58.19s.41-.06.58-.19c.3-.22 7.45-5.37 7.42-11.82 0-4.41-3.59-8-8-8s-8 3.59-8 8c-.03 6.45 7.12 11.6 7.42 11.82M12 4c3.31 0 6 2.69 6 6 .02 4.44-4.39 8.43-6 9.74-1.61-1.31-6.02-5.29-6-9.74 0-3.31 2.69-6 6-6"></path>
              </svg>
              <span data-gallery-dialog-location></span>
            </div>
            <div class  = "date">
              <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
              fill="currentColor" viewBox="0 0 24 24" >
              <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
              <path d="M19 4h-2V2h-2v2H9V2H7v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2M5 20V8h14V6v14z"></path>
              </svg>
              <p data-gallery-dialog-published></p>
            </div>
            <div class="galleryDialogTags" data-gallery-dialog-tags></div>
            <p data-gallery-dialog-description></p>
            
          </div>
      </div>
    </dialog>

    {galleryImagesResponse.data.length > 0 && (
      <div class="galleryLoadMore">
        <button type="button" class="galleryLoadMoreButton" data-gallery-load-more>
          {t.galleryPage.loadMore}
        </button>
      </div>
    )}
  </main>
</BaseLayout>

<script>
  import { getMediaUrl } from '../../lib/media';

  interface GalleryMediaFormat {
    url: string;
  }

  interface GalleryMedia {
    url: string;
    formats?: Record<string, GalleryMediaFormat>;
  }

  interface GalleryApiImage {
    id?: number;
    documentId?: string;
    title: string;
    slug: string;
    description?: string;
    location?: string;
    publishedAt: string;
    tags?: {
      name: string;
    }[] | null;
    author?: {
      name: string;
      profileImage?: {
        url: string;
        alternativeText?: string | null;
        formats?: Record<string, GalleryMediaFormat>;
      } | null;
    } | null;
    image: GalleryMedia | null;
  }

  interface GalleryApiResponse {
    data: GalleryApiImage[];
    meta: {
      pagination: {
        page: number;
        pageCount: number;
        pageSize: number;
        total: number;
      };
    };
  }

  const loadGalleryPage = async (
    strapiUrl: string,
    page: number,
    pageSize: number,
    locale: string,
    tagDocumentId = '',
  ): Promise<GalleryApiResponse> => {
    const getPage = async (selectedLocale: string): Promise<GalleryApiResponse> => {
      const query = new URLSearchParams({
        locale: selectedLocale,
        'populate[image]': 'true',
        'populate[author][populate][0]': 'profileImage',
        'populate[tags]': 'true',
        sort: 'publishedAt:desc',
        'pagination[page]': String(page),
        'pagination[pageSize]': String(pageSize),
      });
      if (tagDocumentId) {
        query.set('filters[tags][documentId][$eq]', tagDocumentId);
      }
      const response = await fetch(`${strapiUrl}/api/gallery-images?${query}`);

      if (!response.ok) {
        throw new Error(`Gallery request failed with status ${response.status}`);
      }

      return response.json() as Promise<GalleryApiResponse>;
    };

    const selectedLocale = locale === 'pt' ? 'pt' : 'en';
    const fallbackLocale = selectedLocale === 'pt' ? 'en' : 'pt';
    const [selectedResponse, fallbackResponse] = await Promise.all([
      getPage(selectedLocale),
      getPage(fallbackLocale),
    ]);

    const selectedItems = Array.isArray(selectedResponse.data)
      ? selectedResponse.data
      : [];
    const fallbackItems = Array.isArray(fallbackResponse.data)
      ? fallbackResponse.data
      : [];
    const selectedByKey = new Map(
      selectedItems.map((item) => [item.documentId ?? item.id, item]),
    );
    const fallbackByKey = new Map(
      fallbackItems.map((item) => [item.documentId ?? item.id, item]),
    );
    const mergedItems = selectedItems.map((selectedItem) => {
      const key = selectedItem.documentId ?? selectedItem.id;
      const fallbackItem = fallbackByKey.get(key);

      if (!fallbackItem) {
        return selectedItem;
      }

      const mergedItem = { ...fallbackItem, ...selectedItem };
      Object.entries(fallbackItem).forEach(([field, fallbackValue]) => {
        const selectedValue = selectedItem[field as keyof GalleryApiImage];
        const isMissing =
          selectedValue === null ||
          selectedValue === undefined ||
          (Array.isArray(selectedValue) && selectedValue.length === 0);

        if (isMissing && fallbackValue !== null && fallbackValue !== undefined) {
          (mergedItem as Record<string, unknown>)[field] = fallbackValue;
        }
      });

      return mergedItem;
    });

    fallbackItems.forEach((fallbackItem) => {
      const key = fallbackItem.documentId ?? fallbackItem.id;
      if (!selectedByKey.has(key)) {
        mergedItems.push(fallbackItem);
      }
    });

    const selectedPagination = selectedResponse.meta.pagination;
    const fallbackPagination = fallbackResponse.meta.pagination;

    return {
      data: mergedItems,
      meta: {
        pagination: {
          page,
          pageSize,
          pageCount: Math.max(
            selectedPagination.pageCount,
            fallbackPagination.pageCount,
          ),
          total: Math.max(
            selectedPagination.total,
            fallbackPagination.total,
          ),
        },
      },
    };
  };

  const createGalleryCard = (
    galleryImage: GalleryApiImage,
    strapiUrl: string,
    enlargeText: string,
  ): HTMLButtonElement | null => {
    if (!galleryImage.image) {
      return null;
    }

    const imageUrl =
      galleryImage.image.formats?.large?.url ??
      galleryImage.image.formats?.medium?.url ??
      galleryImage.image.url;
    const card = document.createElement('button');
    card.className = 'galleryCard';
    card.type = 'button';
    card.setAttribute('aria-label', `${enlargeText}: ${galleryImage.title}`);
    card.dataset.galleryImage = getMediaUrl(imageUrl);
    card.dataset.galleryTitle = galleryImage.title;
    card.dataset.galleryDescription = galleryImage.description ?? '';
    card.dataset.galleryLocation = galleryImage.location ?? '';
    card.dataset.galleryPublished = galleryImage.publishedAt;
    card.dataset.galleryTags = Array.isArray(galleryImage.tags)
      ? galleryImage.tags.map((tag) => tag.name).join('|')
      : '';
    card.dataset.galleryAuthor = galleryImage.author?.name ?? '';
    const authorImageUrl = galleryImage.author?.profileImage
      ? galleryImage.author.profileImage.formats?.thumbnail?.url ??
        galleryImage.author.profileImage.url
      : '';
    card.dataset.galleryAuthorImage = authorImageUrl
      ? getMediaUrl(authorImageUrl)
      : '';

    const image = document.createElement('img');
    image.src = card.dataset.galleryImage;
    image.alt = galleryImage.title;
    image.loading = 'lazy';

    const overlay = document.createElement('div');
    overlay.className = 'galleryCardOverlay';

    const title = document.createElement('h2');
    title.textContent = galleryImage.title;

    overlay.append(title);
    card.append(image, overlay);
    return card;
  };

  const initializeGallery = () => {
    const grid = document.querySelector<HTMLElement>('[data-gallery-grid]');
    const loadMoreButton =
      document.querySelector<HTMLButtonElement>('[data-gallery-load-more]');
    const filterButton =
      document.querySelector<HTMLButtonElement>('[data-gallery-filter-button]');
    const filterOptions =
      document.querySelector<HTMLElement>('[data-gallery-filter-options]');

    if (!grid || !loadMoreButton || !filterButton || !filterOptions) {
      return;
    }

    const strapiUrl = grid.dataset.strapiUrl;
    const locale = grid.dataset.locale ?? 'pt';
    const loadMoreText = grid.dataset.loadMoreText ?? 'Load more';
    const loadingText = grid.dataset.loadingText ?? 'Loading more photos...';
    const loadErrorText =
      grid.dataset.loadErrorText ?? 'Unable to load more photos. Try again.';
    const publishedOnText = grid.dataset.publishedOnText ?? 'Published on';
    const byText = grid.dataset.byText ?? 'By';
    const enlargeText = grid.dataset.enlargeText ?? 'Enlarge image';
    const reduceText = grid.dataset.reduceText ?? 'Reduce image';
    const pageSize = Number(grid.dataset.pageSize);
    const pageCount = Number(grid.dataset.pageCount);

    if (
      !strapiUrl ||
      !Number.isInteger(pageSize) ||
      !Number.isInteger(pageCount)
    ) {
      return;
    }

    let currentPage = 1;
    let isLoading = false;
    let selectedTagDocumentId = '';

    filterButton.addEventListener('click', () => {
      const isOpen = filterButton.getAttribute('aria-expanded') === 'true';
      filterButton.setAttribute('aria-expanded', String(!isOpen));
      filterOptions.hidden = isOpen;
    });

    filterOptions.querySelectorAll<HTMLButtonElement>('[data-gallery-tag]').forEach(
      (tagOption) => {
        tagOption.addEventListener('click', async () => {
          if (isLoading) {
            return;
          }

          selectedTagDocumentId = tagOption.dataset.galleryTag ?? '';
          filterButton.textContent =
            tagOption.dataset.galleryTagName ?? loadMoreText;
          filterButton.setAttribute('aria-expanded', 'false');
          filterOptions.hidden = true;

          isLoading = true;
          grid.replaceChildren();
          loadMoreButton.disabled = true;
          loadMoreButton.textContent = loadingText;
          loadMoreButton.hidden = false;
          loadMoreButton.setAttribute('aria-busy', 'true');

          try {
            const response = await loadGalleryPage(
              strapiUrl,
              1,
              pageSize,
              locale,
              selectedTagDocumentId,
            );
            const cards = response.data
              .map((galleryImage) =>
                createGalleryCard(galleryImage, strapiUrl, enlargeText),
              )
              .filter((card): card is HTMLButtonElement => card !== null);

            grid.append(...cards);
            currentPage = 1;
            const filteredPageCount =
              Number(response.meta?.pagination?.pageCount) || 1;

            loadMoreButton.hidden =
              cards.length === 0 || currentPage >= filteredPageCount;
          } catch (error) {
            console.error('Unable to filter gallery photos.', error);
            loadMoreButton.textContent = loadErrorText;
          } finally {
            isLoading = false;
            loadMoreButton.disabled = false;
            loadMoreButton.removeAttribute('aria-busy');
            if (!loadMoreButton.hidden) {
              loadMoreButton.textContent = loadMoreText;
            }
          }
        });
      },
    );

    loadMoreButton.addEventListener('click', async () => {
      if (isLoading) {
        return;
      }

      isLoading = true;
      loadMoreButton.disabled = true;
      loadMoreButton.textContent = loadingText;
      loadMoreButton.setAttribute('aria-busy', 'true');

      try {
        const nextPage = currentPage + 1;
        const response = await loadGalleryPage(
          strapiUrl,
          nextPage,
          pageSize,
          locale,
          selectedTagDocumentId,
        );
        const cards = response.data
          .map((galleryImage) =>
            createGalleryCard(galleryImage, strapiUrl, enlargeText),
          )
          .filter((card): card is HTMLButtonElement => card !== null);

        if (cards.length === 0) {
          loadMoreButton.hidden = true;
          return;
        }

        grid.append(...cards);
        currentPage = nextPage;
        const loadedCardCount =
          grid.querySelectorAll<HTMLElement>('[data-gallery-image]').length;
        const totalCardCount =
          Number(response.meta?.pagination?.total) || loadedCardCount;

        if (loadedCardCount >= totalCardCount) {
          loadMoreButton.hidden = true;
        }
      } catch (error) {
        console.error('Unable to load more gallery photos.', error);
        loadMoreButton.textContent = loadErrorText;
      } finally {
        isLoading = false;
        loadMoreButton.disabled = false;
        loadMoreButton.removeAttribute('aria-busy');

        if (loadMoreButton.isConnected) {
          window.setTimeout(() => {
            if (loadMoreButton.isConnected && !isLoading) {
              loadMoreButton.textContent = loadMoreText;
            }
          }, loadMoreButton.textContent === loadErrorText ? 3000 : 0);
        }
      }
    });
  };

  const initializeGalleryDialog = () => {
    const grid = document.querySelector<HTMLElement>('[data-gallery-grid]');
    const dialog = document.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
    const image = document.querySelector<HTMLImageElement>('[data-gallery-dialog-image]');
    const title = document.querySelector<HTMLElement>('[data-gallery-dialog-title]');
    const author = document.querySelector<HTMLElement>('[data-gallery-dialog-author]');
    const authorImage = document.querySelector<HTMLImageElement>(
      '[data-gallery-dialog-author-image]',
    );
    const location = document.querySelector<HTMLElement>('[data-gallery-dialog-location]');
    const published = document.querySelector<HTMLElement>('[data-gallery-dialog-published]');
    const description = document.querySelector<HTMLElement>('[data-gallery-dialog-description]');
    const tags = document.querySelector<HTMLElement>('[data-gallery-dialog-tags]');
    const closeButton = document.querySelector<HTMLButtonElement>('[data-gallery-dialog-close]');
    const locale = grid?.dataset.locale ?? 'pt';
    const byText = grid?.dataset.byText ?? 'By';
    const publishedOnText = grid?.dataset.publishedOnText ?? 'Published on';
    const enlargeText = grid?.dataset.enlargeText ?? 'Enlarge image';
    const reduceText = grid?.dataset.reduceText ?? 'Reduce image';

    if (
      !dialog ||
      !image ||
      !title ||
      !author ||
      !authorImage ||
      !location ||
      !published ||
      !description ||
      !tags ||
      !closeButton
    ) {
      return;
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      const card =
        target instanceof Element
          ? target.closest<HTMLElement>('[data-gallery-image]')
          : null;

      if (!card) {
        return;
      }

      event.preventDefault();
      image.classList.remove('isZoomed');
      image.setAttribute('aria-label', enlargeText);
      image.src = card.dataset.galleryImage ?? '';
      image.alt = card.dataset.galleryTitle ?? '';
      title.textContent = card.dataset.galleryTitle ?? '';
      author.textContent = card.dataset.galleryAuthor
        ? `${byText} ${card.dataset.galleryAuthor}`
        : '';
      authorImage.src = card.dataset.galleryAuthorImage ?? '';
      authorImage.alt = card.dataset.galleryAuthor ?? '';
      authorImage.hidden = !card.dataset.galleryAuthorImage;
      location.textContent = card.dataset.galleryLocation ?? '';
      published.textContent = card.dataset.galleryPublished
        ? `${publishedOnText} ${new Intl.DateTimeFormat(locale === 'pt' ? 'pt-PT' : 'en', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          }).format(new Date(card.dataset.galleryPublished))}`
        : '';
      description.textContent = card.dataset.galleryDescription ?? '';
      tags.replaceChildren(
        ...(card.dataset.galleryTags ?? '')
          .split('|')
          .filter(Boolean)
          .map((tag) => {
            const tagElement = document.createElement('span');
            tagElement.textContent = `${tag}`;
            return tagElement;
          }),
      );
      dialog.showModal();
    });

    image.addEventListener('click', () => {
      const isZoomed = image.classList.toggle('isZoomed');
      image.setAttribute(
        'aria-label',
        isZoomed ? reduceText : enlargeText,
      );
    });

    closeButton.addEventListener('click', () => {
      image.classList.remove('isZoomed');
      dialog.close();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeGallery, {
      once: true,
    });
  } else {
    initializeGallery();
  }

  initializeGalleryDialog();
</script>

<style>
  .galleryPage {
    padding: 80px;
    background: #ffffff;
  }

  .galleryHeader {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    
    }
.galleryHeader section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 100%;
  }
  .galleryHeader h1 {
    margin: 0;
    font-size: 200px;
    color: #ffffff;
  }

  .galleryHeader p {
    font-size: 20px;
    color: #ffffff;
  }

  .galleryGrid {
    display: block;
    column-count: 3;
    column-gap: 24px;
    max-width: 1440px;
    margin: 0 auto;
  }

  .galleryFilter {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 1440px;
    margin: 0 auto 24px;
    padding-bottom: 15px;
    border-bottom: 3px solid #000000;
    color: #000;
    font-size: 26px;
  }

  .galleryFilterMenu {
    position: relative;
  }

  .galleryFilterButton,
  .galleryFilterOptions button {
    border: 2px solid #000;
    border-radius: 4px;
    cursor: pointer;
    font: inherit;
  }

  .galleryFilterButton {
    min-width: 120px;
    padding: 0.35rem 1rem;
  }

  .galleryFilterOptions {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 20;
    min-width: 180px;
    max-height: 260px;
    overflow-y: auto;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    background: #ffffff;
  }

  .galleryFilterOptions button {
    display: block;
    width: 100%;
    border: 0;
    border-radius: 0;
    padding: 0.65rem 1rem;
    text-align: left;
  }

  .galleryFilterOptions button:hover,
  .galleryFilterOptions button:focus-visible {
    background: #f1f5f9;
  }

  .galleryLoadMore {
    display: flex;
    justify-content: center;
    margin: 24px auto 0;
    font-size: 20px;
    font-weight: bold;
  }
  

  .galleryLoadMoreButton {
    border: 0;
    border-radius: 4px;
    background: var(--color-primary);
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    padding: 0.75rem 11rem;
  }
  .galleryLoadMoreButton:hover{
    transition: background-color 0.3s ease;
    background-color: var(--color-primary-dark);
  }

  .galleryLoadMoreButton:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .galleryDialog {
    width: min(96%, 1152px);
    max-height: 94vh;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: #ffffff;
    scrollbar-width: none; /* Deixa a barra de rolagem fina */
  }

  .galleryDialog::backdrop {
    background: rgb(0 0 0 / 70%);
  }

  .galleryDialogContent {
    display: flex;
    max-height: 94vh;
    flex-direction: column;
  }

  .galleryDialogHeader{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  .galleryDialogHeader {
    border-bottom: 1px solid #e2e8f0;
  }

  .galleryDialogHeader h2,
  .galleryDialogHeader p,
  .galleryDialogFooter p {
    margin: 0;
  }
  .galleryDialogHeader{
    
  }
  .DialogAuthor{
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  .galleryDialogAuthor {
    align-items: center;
    margin-left: 1rem;
  }
  .galleryDialogAuthor p{
    margin-top: -5px;
  }

  .pfp {
