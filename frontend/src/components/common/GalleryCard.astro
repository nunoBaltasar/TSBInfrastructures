---
import { getLocale, translations } from '../../lib/i18n';

interface Props {
  title: string;
  image: string;
  slug: string;
  description?: string;
  location?: string;
  publishedAt: string;
  authorName?: string;
  authorImage?: string;
  tags?: string[];
  tagIds?: string[];
  hidden?: boolean;
}

const {
  title,
  image,
  slug,
  description,
  location,
  publishedAt,
  authorName,
  authorImage,
  tags,
  tagIds,
  hidden,
} = Astro.props as Props;

const t = translations[getLocale(Astro.url.pathname)];
---

<button
  type="button"
  class="galleryCard"
  data-gallery-image={image}
  data-gallery-title={title}
  data-gallery-description={description ?? ''}
  data-gallery-location={location ?? ''}
  data-gallery-published={publishedAt}
  data-gallery-author={authorName ?? ''}
  data-gallery-author-image={authorImage ?? ''}
  data-gallery-tags={tags?.join('|') ?? ''}
  data-gallery-tag-ids={tagIds?.join('|') ?? ''}
  hidden={hidden}
  aria-label={`${t.galleryPage.enlarge}: ${title}`}
>
  <img src={image} alt={title} loading="lazy" />

  <div class="galleryCardOverlay">
    <h2>{title}</h2>
  </div>
</button>

<style>
  :global(.galleryCard[hidden]) {
    display: none !important;
  }

  :global(.galleryCard) {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: zoom-in;
    overflow: hidden;
    break-inside: avoid;
    margin-bottom: 24px;
    color: #ffffff;
    
  }

  :global(.galleryCard img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.3s ease;
  }

  :global(.galleryCardOverlay) {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 48px 20px 20px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  :global(.galleryCard h2) {
    margin: 0;
    font-size: 24px;
  }

  :global(.galleryCard p),
  :global(.galleryCard span) {
    display: block;
    margin: 6px 0 0;
  }

  :global(.galleryCard span) {
    overflow: hidden;
    font-size: 14px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.galleryCard:hover img) {
    transform: scale(1.03);
  }

  :global(.galleryCard:hover .galleryCardOverlay),
  :global(.galleryCard:focus-visible .galleryCardOverlay) {
    opacity: 1;
  }
</style>