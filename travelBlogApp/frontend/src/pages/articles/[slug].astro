---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StrapiBlocks from '../../components/common/StrapiBlocks.astro';
import fetchApi from '../../lib/strapi';
import type { Article, StrapiCollectionResponse } from '../../interfaces/strapi';

export async function getStaticPaths() {
  const response = await fetchApi<StrapiCollectionResponse<Article>>({
      endpoint: 'articles',
      query: {
        populate: '*',
        'pagination[pageSize]': '100',
      },
    });

  return response.data.map((article) => ({
    params: {
      slug: article.slug,
    },
    props: {
      article,
    },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;

const strapiUrl = import.meta.env.STRAPI_URL;
const getMediaUrl = (url: string) =>
  url.startsWith('http') ? url : `${strapiUrl}${url}`;

const coverUrl = article.coverImage
  ? getMediaUrl(article.coverImage.formats?.large?.url ?? article.coverImage.url)
  : null;

const publicationDate = new Intl.DateTimeFormat(
  'pt-PT',
  {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }
).format(new Date(article.publishedAt));
---

<BaseLayout title={`${article.title} | Travel Blog`} description={article.summary}>
    <header class="galleryHeader">
    <section
      class="articleHero"
      style={`background-image:
        linear-gradient(to right, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.7) 5%, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.7) 95%, rgba(0, 0, 0, 0.95) 100%),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.3) 20%, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.3) 80%, rgba(0, 0, 0, 0.95) 100%),
        url('${coverUrl ?? ''}');`}
    >
    </section>

    <div class="heroOverlayContent">
      <h1>{article.title}</h1>
      <p>{article.summary}</p>
    </div>
  </header>
  <article class="mx-auto max-w-4xl px-6 py-16">
    <div class="flex items-center justify-between mb-6">
      <div class="text-sm text-gray-500">
        <span>By {article.author?.name ?? 'TravelBlog'}</span>
        <span class="mx-2">|</span>
        <span>{publicationDate}</span>
      </div>
    </div>
    <div class="mt-12">
      <StrapiBlocks content={article.content} mediaBaseUrl={strapiUrl} />
    </div>
  </article>
</BaseLayout>

<style>
  .galleryHeader {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden; /* Corta rigorosamente o blur que tenta sair para fora */
    background-color: #000000; /* Garante que qualquer espaço vazio atrás é preto */
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .articleHero {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(4.5px) brightness(0.7); /* Aplica o efeito de desfoque e escurece a imagem */
    /*transform: scale(.55);  Empurra as bordas brancas do blur para fora do ecrã */
    z-index: 1;
  }

  .heroOverlayContent {
    position: relative;
    z-index: 2; /* Mantém o texto nítido por cima do fundo desfocado */
    box-sizing: border-box;
    width: min(1060px, calc(100% - 48px));
    text-align: center;
    color: #ffffff;
    border: 3px solid #ffffff;
    padding: 74px 8px 96px;
  }

  .heroOverlayContent h1 {
    max-width: 880px;
    margin: 0 auto;
    font-size: 110px;
    line-height: 1;

  }
  .heroOverlayContent p {
    font-size: 20px;
    max-width: 800px;
    margin: 32px auto 0;
  }

  .mt12{
    margin-top: 40px;
  }
</style>