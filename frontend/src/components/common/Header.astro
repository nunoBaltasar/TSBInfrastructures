---
import {
  getLocale,
  localizedPath,
  translations,
  type Locale,
} from '../../lib/i18n';

const locale = getLocale(Astro.url.pathname);
const t = translations[locale];
const languagePath = (language: Locale) =>
  localizedPath(language, Astro.url.pathname);
const route = Astro.url.pathname
  .replace(/^\/(pt|en)(?=\/|$)/, '')
  .replace(/\/+$/, '') || '/';
const isHome = route === '/';
const isArticles = route === '/articles' || route.startsWith('/articles/');
const isGallery = route === '/gallery';
const isContributors = route === '/contributors';
---

<header>
  <nav class = "header">
    <a href={localizedPath(locale, '/')} class = "logo">TravelBlog</a>
    <div class="links">
      <div class = "pages">
        <a
          class:list={{ active: isHome }}
          href={localizedPath(locale, '/')}
          aria-current={isHome ? 'page' : undefined}
        >
          {t.navigation.home}
        </a>
        <a
          class:list={{ active: isArticles }}
          href={localizedPath(locale, '/articles')}
          aria-current={isArticles ? 'page' : undefined}
        >
          {t.navigation.articles}
        </a>
        <a
          class:list={{ active: isGallery }}
          href={localizedPath(locale, '/gallery')}
          aria-current={isGallery ? 'page' : undefined}
        >
          {t.navigation.gallery}
        </a>
        <a
          class:list={{ active: isContributors }}
          href={localizedPath(locale, '/contributors')}
          aria-current={isContributors ? 'page' : undefined}
        >
          {t.navigation.contributors}
        </a>

      </div>
      <div class="languageSelector" aria-label={t.language}>
        <a class:list={{ active: locale === 'pt' }} href={languagePath('pt')} aria-current={locale === 'pt' ? 'page' : undefined}>PT</a>
        <a class:list={{ active: locale === 'en' }} href={languagePath('en')} aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
      </div>
  </div>
    
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.header');

  if (header) {
    const updateHeader = () => {
      header.classList.toggle('scrolled', window.scrollY > 0);
    };

    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  }
</script>


<style>
  
header .header{
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 20px 50px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: transparent; /* Transparente inicialmente */
    transition: background-color 0.3s ease, padding 0.3s ease; /* Animação suave */
    z-index: 1000;
    box-sizing: border-box;

}

header .header.scrolled {
  background-color: #000; /* Cor escura da barra */
}


header .header  a {
    font-size: 20px;
    color: #ffffff;
    font-weight: 300;
}
header .header  .logo{
    color: #74ff74;
    font-size: 30px;
    font-weight: 700;
}

.links{
  display: flex;
  align-items: center;
  flex-direction: row;
}

.pages a{
    margin-right: 30px;
}

.pages a.active {
  text-decoration: underline;
  text-decoration-color: #ffffff;
  text-decoration-thickness: 2px;
  text-underline-offset: 8px;
}

header .header .languageSelector {
  display: flex;
  margin-right: 40px;

}

header .header .languageSelector a{
 
  margin-right: 10px;

}
header .header .languageSelector a {
  border-radius: 8px;
  font-size: 20px;
  padding: 7px 14px;
  font-weight: 700;
  
  text-decoration: none;
}

header .header .languageSelector a.active {
  background-color: var(--color-primary);
  color: #ffffff;
}

header .header .languageSelector a:not(.active) {
  background-color: rgb(184, 184, 184);
  color: #000;
}

header .header .languageSelector a:not(.active):hover {
  transition: background-color 0.3s ease;
  background-color: var(--color-primary-dark);
  color: #ffffff;
}
</style>

